# --- Storage (omit to run on the in-memory demo store) ---
MONGODB_URI=
MONGODB_DB=brandproof

# --- Sessions ---
# 32+ random characters. Generate one: openssl rand -base64 32
SESSION_SECRET=

# --- Demo mode: one-click sign-in as admin / author / approver ---
DEMO_MODE=true
DEMO_PASSWORD=proof-demo-2026

# --- LLM provider: anthropic | openai | mock (default: auto-detect from keys, else mock) ---
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model id for the chosen provider (required for openai; anthropic defaults to claude-sonnet-5-5)
LLM_MODEL=
